rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Fonctions utilitaires ────────────────────────────────────────────────

    function estConnecte() {
      return request.auth != null;
    }

    function estSuperAdmin() {
      return estConnecte() &&
        get(/databases/$(database)/documents/utilisateurs/$(request.auth.uid)).data.role == 'superAdmin';
    }

    function estProprietaire(userId) {
      return estConnecte() && request.auth.uid == userId;
    }

    // ── Collection utilisateurs ──────────────────────────────────────────────
    match /utilisateurs/{userId} {
      // Un utilisateur peut lire et modifier son propre profil
      allow read, write: if estProprietaire(userId);
      // Le super admin peut tout lire et modifier
      allow read, write: if estSuperAdmin();
      // Un utilisateur connecté peut créer son propre profil (inscription)
      allow create: if estConnecte() && request.auth.uid == userId;
    }

    // ── Collection écoles ────────────────────────────────────────────────────
    match /ecoles_rdc/{ecoleId} {
      // Tout utilisateur connecté peut lire les écoles
      allow read: if estConnecte();
      // Seul le super admin peut créer/modifier/supprimer
      allow write: if estSuperAdmin();
    }

    // ── Collection classes ───────────────────────────────────────────────────
    match /classes_rdc/{classeId} {
      allow read: if estConnecte();
      allow write: if estSuperAdmin();
    }

    // ── Collection élèves ────────────────────────────────────────────────────
    match /eleves/{eleveId} {
      // Un élève peut lire son propre dossier
      allow read: if estConnecte();
      allow write: if estSuperAdmin();
    }

    // ── Collection invitations directeurs ───────────────────────────────────
    match /invitations_directeurs/{invId} {
      // Lecture possible pour valider un token d'invitation (non authentifié)
      allow read: if true;
      // Écriture réservée au super admin (création) ou à l'utilisateur qui consomme (update)
      allow create: if estSuperAdmin();
      allow update: if estConnecte();
    }

    // ── Collections de données scolaires ────────────────────────────────────
    match /notes/{noteId} {
      allow read: if estConnecte();
      allow write: if estSuperAdmin();
    }

    match /presences/{presenceId} {
      allow read: if estConnecte();
      allow write: if estConnecte();
    }

    match /devoirs/{devoirId} {
      allow read: if estConnecte();
      allow write: if estConnecte();
    }

    match /notifications/{notifId} {
      allow read: if estConnecte();
      allow write: if estConnecte();
    }

    // ── Règle par défaut : refus de tout accès non spécifié ─────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
