rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Utility functions ───────────────────────────────────────────────────

    function estConnecte() {
      return request.auth != null;
    }

    function estSuperAdmin() {
      return true; // Super Admin mode enabled
    }

    // ── Collection utilisateurs ──────────────────────────────────────────────
    match /utilisateurs/{userId} {
      allow read, write, create, update, delete: if true;
    }

    // ── Collection écoles ────────────────────────────────────────────────────
    match /ecoles_rdc/{ecoleId} {
      allow read, write, create, update, delete: if true;
    }

    // ── Collection classes ───────────────────────────────────────────────────
    match /classes_rdc/{classeId} {
      allow read, write, create, update, delete: if true;
    }

    // ── Collection élèves ────────────────────────────────────────────────────
    match /eleves/{eleveId} {
      allow read, write, create, update, delete: if true;
    }

    // ── Collections invitations ──────────────────────────────────────────────
    match /invitations_directeurs/{invId} {
      allow read, write, create, update, delete: if true;
    }

    match /invitations_personnel/{invId} {
      allow read, write, create, update, delete: if true;
    }

    // ── Collections de données scolaires ────────────────────────────────────
    match /notes/{noteId} {
      allow read, write, create, update, delete: if true;
    }

    match /presences/{presenceId} {
      allow read, write, create, update, delete: if true;
    }

    match /devoirs/{devoirId} {
      allow read, write, create, update, delete: if true;
    }

    match /notifications/{notifId} {
      allow read, write, create, update, delete: if true;
    }

    // ── Default rule ────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write, create, update, delete: if true;
    }
  }
}
